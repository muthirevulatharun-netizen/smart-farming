# ============================================================
# Smart Farming AI Assistant - Configuration
# ============================================================

# Application Environment (development / production)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Frontend CORS Origin
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (PostgreSQL in production, SQLite fallback in development)
# For SQLite: sqlite:///./smart_farming.db
# For PostgreSQL: postgresql://postgres:password@localhost:5432/smart_farming
DATABASE_URL=sqlite:///./smart_farming.db

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_smart_farming_ai_change_in_production_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mobile OTP Provider (mock or twilio)
OTP_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# AI LLM Provider Configuration
# Supported: gemini, openai, or mock (fallback)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Weather API Configuration (Open-Meteo free by default, OpenWeather optional)
WEATHER_PROVIDER=openmeteo
WEATHER_API_KEY=

# File Upload Directory
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=10
